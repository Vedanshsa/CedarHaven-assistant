# Server-side only. Copy this file to .env and provide private values.
GROQ_API_KEY=replace-with-your-groq-api-key
# Local-first storage. SQLite keeps accounts and chat history in this project folder.
DATABASE_URL=sqlite:///./cedarhaven.db
# For Supabase or another PostgreSQL provider, replace DATABASE_URL with its
# PostgreSQL connection URI (include sslmode=require when the provider requires TLS).
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
UPLOAD_DIR=./uploads
FRONTEND_URL=http://localhost:3000
MAX_QUESTION_CHARS=4000

# LiveKit voice agent (optional; required only for voice mode).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=assistant-b92
DEEPGRAM_API_KEY=replace-with-your-deepgram-api-key
DEEPGRAM_STT_MODE=flux
DEEPGRAM_STT_MODEL=flux-general-en
DEEPGRAM_STT_LANGUAGE=en
DEEPGRAM_TTS_MODEL=aura-2-asteria-en
